# apps/server env. Copy to `.env` and fill it in. Never commit a real value.
#
#   cp .env.example .env
#
# In dev, `vite.config.ts` copies `.env` into the server's environment.
# `bun run start` gets it from Bun itself.
#
# Values are read when first needed, not at import. A missing one fails the
# request that uses it, and the error names the variable.

# ── Required ──────────────────────────────────────────────────

# Neon Postgres connection string. Neon gives you this, you do not make one.
# console.neon.tech, your project, Connect, copy the postgresql://... string.
# Keep ?sslmode=require.
# Use a dev branch for migrations: `bun run db:migrate` creates tables.
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Signs session tokens. Generate it:
#   openssl rand -base64 32
# Use the same value on every instance, or users get randomly logged out.
# Rotating it logs everyone out. Treat it as a password.
BETTER_AUTH_SECRET=""

# This server's public URL, no trailing slash. Wherever you deployed it:
#   local  http://localhost:5173
#   Fly    https://<your-app>.fly.dev
# Empty is fine for local testing.
APP_ORIGIN=""

# Other origins allowed to call the auth endpoints. Fixed by the native shells,
# not generated, and both are already listed. Leave it alone.
TRUSTED_ORIGINS="capacitor://localhost,https://localhost"

# ── Optional. Each one has a working default. ─────────────────

# Read by adapter-node. Fly sets PORT. Leave both unset normally.
# PORT=3000
# HOST=0.0.0.0

# Heartbeat for /api/v1/stream, in ms. Default 25000, range 5000 to 60000.
# Stay under 60s, where most proxies drop an idle connection.
# SSE_KEEPALIVE_MS=25000

# Requests per 60s per IP on /api/v1/*. Default 120, range 1 to 100000.
# In memory, per instance. It catches a stuck client, not an attack.
# RATE_LIMIT_V1=120

# Check it works. No login needed:
#   curl -s http://localhost:5173/api/v1/health
