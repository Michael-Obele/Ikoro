{
	"name": "app",
	"private": true,
	"version": "0.3.8",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run check:android",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:android": "./android/gradlew -p android --console=plain :app:ktlintCheck :app:compileDebugKotlin :app:lintDebug",
		"typecheck:kotlin": "./android/gradlew -p android --console=plain :app:compileDebugKotlin",
		"lint:kotlin": "./android/gradlew -p android --console=plain :app:ktlintCheck",
		"format:kotlin": "./android/gradlew -p android --console=plain :app:ktlintFormat",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@capacitor/android": "8.5.2",
		"@capacitor/cli": "8.5.2",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@resvg/resvg-js": "2.6.2",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "2.12.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"cn": "^0.3.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"jsdom": "^30.1.1",
		"lucide-svelte": "^1.0.1",
		"playwright-core": "^1.64.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"$lib": "./src/lib/index.js",
		"$lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@capacitor/app": "8.1.2",
		"@capacitor/core": "8.5.2",
		"@capacitor/filesystem": "^8.1.5",
		"@capacitor/local-notifications": "8.3.1",
		"@capacitor/share": "^8.0.3",
		"@capacitor/status-bar": "^8.0.4",
		"@ikoro/sync": "workspace:*",
		"@internationalized/date": "3.12.0",
		"@lucide/svelte": "^1.63.0",
		"@tauri-apps/api": "2.12.1",
		"@tauri-apps/plugin-notification": "2.5.1",
		"bits-ui": "2.19.5",
		"ikoro-dynamic-colors": "workspace:*",
		"runed": "0.37.1",
		"sv-agentation": "^0.4.0",
		"svelte-dnd-action": "0.9.79",
		"svelte-idb": "0.1.6",
		"svelte-sonner": "^1.2.2",
		"valibot": "1.5.0"
	}
}
