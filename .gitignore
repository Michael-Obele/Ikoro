# ── dependencies ──────────────────────────────────────────────────────────────
node_modules/
.bun/
bun.lockb
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── SvelteKit ─────────────────────────────────────────────────────────────────
.svelte-kit/
# adapter-static output. Scoped to apps/ so it can never swallow docs/build/.
apps/*/build/

# ── shared packages ───────────────────────────────────────────────────────────
packages/*/dist/
packages/*/.svelte-kit/

# ── Tauri (apps/app) ──────────────────────────────────────────────────────────
apps/app/src-tauri/target/
apps/app/src-tauri/gen/

# ── Capacitor / Android (apps/app) ────────────────────────────────────────────
apps/app/android/.gradle/
apps/app/android/build/
apps/app/android/app/build/
apps/app/android/local.properties
apps/app/android/.idea/
# cap sync copies the web build in here — never commit it
apps/app/android/app/src/main/assets/public/
apps/app/android/app/src/main/assets/capacitor.config.json
apps/app/android/app/src/main/assets/capacitor.plugins.json

# ── Prisma ────────────────────────────────────────────────────────────────────
*.db
*.db-journal

# ── env / secrets ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── editors, OS, logs ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/mcp.json

# ── local, untracked planning material ──────────────────────────────────────
# The plan travels with the machine, not the repository: /plan/ is the original
# AI-Plans copy, /docs/ is the working tree derived from it. Both are local-only
# on purpose — a fresh clone builds fine without either. See README.md.
/plan/
/docs/
