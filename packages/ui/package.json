{
	"name": "@ikoro/ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "shadcn-svelte components shared by apps/app and apps/landing. Consumed as SOURCE — no build step (D21).",
	"svelte": "./src/lib/index.ts",
