		},
		"./*": "./src/lib/*"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"bits-ui": "2.19.5",
		"cn": "^0.3.0",
		"tailwind-variants": "3.3.1"
	},
	"peerDependencies": {
		"svelte": "^5.57.1",
		"tailwindcss": "^4.3.0"
	},
	"devDependencies": {
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3"
	}
}
